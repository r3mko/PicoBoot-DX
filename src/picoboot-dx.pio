.define PUBLIC CS_PIN 4         ; U10 chip select
.define PUBLIC CLK_PIN 5        ; EXI clock signal

.program on_transfer

; Not covered: a CS glitch right before the 225th transfer (X = 0 doesn't wait for CLK) starts the
; injection one transfer early, and one between payload transfers shifts a later transfer by one bit.

start:
    wait 1 gpio CS_PIN          ; Wait for CS to go HIGH
    wait 0 gpio CS_PIN          ; Wait for CS to go LOW
    jmp !x inject               ; 224 transfers skipped (X = 0): this is the 225th, inject now
    wait 1 gpio CLK_PIN         ; A skipped transfer only counts once it clocks...
    jmp pin start               ; ...while CS is still low (JMP_PIN = CS): a CS glitch doesn't count
    jmp x-- start               ; Count the skipped transfer (X > 0 here, so this always jumps)
inject:
    irq set 0                   ; Set IRQ flag to start injecting payload

.wrap_target
    wait 1 gpio CS_PIN          ; Wait for CS to go HIGH
    wait 0 gpio CS_PIN          ; Wait for CS to go LOW
    irq set 0                   ; Let other SM inject the payload
.wrap

.program clocked_output

start:
    set x, 31                   ; x - 32 bits we need to skip (address)
    wait 1 irq 0                ; Hold until SM0 tells us to start injecting

wait_bit:
    wait 0 gpio CLK_PIN         ; Wait for a rising edge on CLK: CLK low first...
    wait 1 gpio CLK_PIN         ; ...then CLK high
    jmp x-- wait_bit            ; Skip past address bytes
    mov x, y                    ; Copy y value to x, it represents number of bits in the transfer
    set pindirs 1               ; Set data line as output
    jmp write_bit               ; Output first IPL bit from OSR

on_rising_edge:
    wait 0 gpio CLK_PIN         ; Wait for a rising edge on CLK: CLK low first...
    wait 1 gpio CLK_PIN         ; ...then CLK high

write_bit:
    out pins, 1                 ; Output single IPL bit
    jmp x-- on_rising_edge      ; Jump back to next clock pulse wait routine if there is more data to inject
    jmp !osre start             ; More payload data (autopull refilled OSR from the FIFO)? Then wait for the next transfer
    wait 1 gpio CS_PIN          ; Keep driving the last bit until the console ends the transfer (CS HIGH)
    set pindirs 0               ; Leave data line floating so RTC-DOL can take over and load fonts etc.

public disable_chip:
    jmp disable_chip            ; Stay in the loop forever until power cycle
